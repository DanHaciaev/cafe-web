# Локальная разработка: оставьте пустым — будет использоваться файл ./local.db
# Продакшн (Vercel): создайте бесплатную БД на https://turso.tech и вставьте значения из `turso db show <name> --url` и `turso db tokens create <name>`
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Пароль для входа в /admin. Обязателен и на проде, и локально.
ADMIN_PASSWORD=
# Необязательно — свой секрет для подписи cookie сессии. Если не задан,
# используется ADMIN_PASSWORD (тогда смена пароля разлогинит всех).
ADMIN_SESSION_SECRET=
