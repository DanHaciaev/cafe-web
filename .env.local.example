# Локальная разработка: оставьте пустым — будет использоваться файл ./local.db
# Продакшн (Vercel): создайте бесплатную БД на https://turso.tech и вставьте значения из `turso db show <name> --url` и `turso db tokens create <name>`
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Пароль для входа в /admin НЕ задаётся тут — при первом открытии
# /admin/login сайт сам предложит его придумать и сохранит (хешированным)
# в базе. Менять пароль потом можно на странице /admin/settings.
